# Bandaru Trade Research (MERN) — environment template
# Copy to .env and edit. docker-compose.yml reads these via ${VAR_NAME}.

# Data source: "yahoo" (default, no auth) or "schwab" (requires keys below)
DATA_SOURCE=yahoo

# Optional: Schwab API credentials. Leave blank to use Yahoo only.
# See https://developer.schwab.com to apply for an Individual Developer account.
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1

# Optional: Finnhub key — adds Finnhub headlines to the News Stock Feed.
# Free key at https://finnhub.io/register. Leave blank to skip Finnhub.
FINNHUB_API_KEY=
