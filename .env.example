# Schwab API credentials — get these at https://developer.schwab.com
# 1. Create an "Individual Developer" account and a new app.
# 2. Set the app's Callback URL to: https://127.0.0.1
# 3. Wait for app approval (usually 1-3 business days).
# 4. Copy the App Key and Secret here.
SCHWAB_API_KEY=your_schwab_app_key
SCHWAB_APP_SECRET=your_schwab_app_secret
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_TOKEN_PATH=./schwab_token.json

# --- Unusual Whales API ---
# Get your API token at https://unusualwhales.com (Account → API).
# If you don't have API access on your plan, you can add it at
# https://unusualwhales.com/pricing?product=api
UNUSUAL_WHALES_API_KEY=your_uw_api_key

# --- TastyTrade ---
# Your tastytrade.com login email + password. Sign up at:
#   https://my.tastytrade.com/sign-up
# Fund with $1 minimum to enable real-time data.
# These ARE your account credentials — keep .env in .gitignore (it already is).
TASTYTRADE_USERNAME=your_tastytrade_email
TASTYTRADE_PASSWORD=your_tastytrade_password

# --- Finnhub (stock news feed) ---
# Free API key that adds Finnhub headlines to the News tab's Stock Market Feed.
# Sign up (free) at https://finnhub.io/register and paste the key below.
# Leave this BLANK to skip Finnhub — the Stock Market Feed still works on the
# Google News, Yahoo Finance and MarketWatch sources.
FINNHUB_API_KEY=
