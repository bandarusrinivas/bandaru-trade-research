# ── Discord ──────────────────────────────────────────────────────────────────
# Developer Portal → Applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Comma-separated channel IDs to forward from (used by the BOT-based bridge,
# index.js). In Discord: Settings → Advanced → Developer Mode ON, then
# right-click a channel → Copy Channel ID.
CHANNEL_IDS=

# Comma-separated substrings used by the notification-bridge (Hammerspoon)
# variant. macOS notifications don't expose channel IDs, only a "title" that
# Discord populates with either the channel name (#general) or the server
# name. Match by case-insensitive substring; leave blank to forward
# everything.
#   Examples:  charan,investorplace      or      #signals,trading-alerts
DISCORD_CHANNEL_FILTER=

# ── Message sender ───────────────────────────────────────────────────────────
# The watcher picks the first fully-populated provider group below, in this
# order:  TELEGRAM_*  →  TWILIO_*  →  WHATSAPP_*.
# Fill in exactly ONE group.

# ── Option A: Telegram bot (recommended — no business account, no signup) ──
# Get the bot token by messaging @BotFather on Telegram → /newbot.
TELEGRAM_BOT_TOKEN=

# The numeric ID of the chat/user you want messages sent to. To find yours:
#   1. Start a chat with your bot and tap "Start" (or send any message).
#   2. Open in a browser:
#        https://api.telegram.org/bot<TOKEN>/getUpdates
#      Replace <TOKEN> with the value above.
#   3. Look for  "chat":{"id":<NUMBER>, ...} — that NUMBER goes here.
TELEGRAM_CHAT_ID=

# ── Option B: Twilio WhatsApp sandbox ───────────────────────────────────────
# Console → Account → API keys & tokens. Account SID starts "AC...".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Sandbox sender, shown on Messaging → Try it out → Send a WhatsApp message.
# Typically whatsapp:+14155238886 — include the "whatsapp:" prefix or let the
# watcher add it.
TWILIO_FROM=whatsapp:+14155238886

# Your own WhatsApp number in E.164. Must have joined the sandbox by texting
# "join <code>" to the sandbox number first.
TWILIO_TO=whatsapp:+

# ── Option B: Meta WhatsApp Cloud API ───────────────────────────────────────
# Meta Business → WhatsApp → API Setup → "From" phone number ID
WHATSAPP_PHONE_ID=

# Meta Business → WhatsApp → API Setup → temporary access token (24h)
# or System User permanent token (recommended for production).
WHATSAPP_TOKEN=

# Recipient in E.164 without the leading +  (e.g. 14155551234, 919812345678).
# Must be added as a verified recipient under "To" while you're on the test
# number.
WHATSAPP_TO=

# Optional: graph API version. Bump if Meta deprecates.
WHATSAPP_API_VERSION=v20.0
