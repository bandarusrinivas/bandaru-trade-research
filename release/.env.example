# Bandaru Trade Research — release configuration.
#
# Copy this file to ".env" (same folder as docker-compose.yml), then edit.
# Every value is optional: with no .env at all, the app runs on free,
# ~15-minute-delayed Yahoo Finance data.

# Image tag to run — must match the version you were given.
BANDARU_VERSION=2.2.0

# Data source:  yahoo  = free, ~15-min delayed (default)
#               schwab = real-time (needs the schwab profile + your own keys)
DATA_SOURCE=yahoo

# If a Schwab call fails, fall back to delayed Yahoo data automatically.
SCHWAB_FALLBACK_TO_YAHOO=true

# Optional: a free Finnhub API key adds Finnhub headlines to the News tab.
# Get one at https://finnhub.io/register
FINNHUB_API_KEY=

# ---- Schwab real-time data (advanced — only if you run `--profile schwab`) ----
# Requires your own Schwab brokerage account + a free Schwab developer app,
# plus a one-time OAuth token file in ./tokens/schwab_token.json. See README.md.
# SCHWAB_API_KEY=
# SCHWAB_APP_SECRET=
# SCHWAB_CALLBACK_URL=https://127.0.0.1
